---
import starpodConfig from 'virtual:starpod/config';
import type { NavLinkIcon } from '../utils/config';
import {
  ArrowOutIcon,
  BagIcon,
  HeartIcon,
  InfoIcon,
  LinkIcon,
  MailIcon,
  MegaphoneIcon
} from './icons';

export interface Props {
  /**
   * In the desktop rail: each link is a piece anchored to its own slot, so it
   * can travel when the rail collapses (styles/rail.css).
   */
  anchored?: boolean;
}

const links = starpodConfig.links ?? [];
const path = Astro.url.pathname.replace(/\/$/, '');
const isExternal = (href: string) => /^https?:\/\//.test(href);
const ICONS: Record<NavLinkIcon, typeof LinkIcon> = {
  external: ArrowOutIcon,
  heart: HeartIcon,
  link: LinkIcon,
  sponsor: MegaphoneIcon,
  store: BagIcon
};
const iconFor = (link: (typeof links)[number]) =>
  ICONS[link.icon ?? (isExternal(link.href) ? 'external' : 'link')];

const items: Array<{
  href: string;
  Icon: typeof LinkIcon;
  label: string;
  rel?: string;
}> = [
  { href: '/about', Icon: InfoIcon, label: 'About' },
  { href: '/contact', Icon: MailIcon, label: 'Contact' },
  ...links.map((link) => ({
    href: link.href,
    Icon: iconFor(link),
    label: link.label,
    rel: isExternal(link.href) ? 'noopener' : undefined
  }))
];
const slot = Astro.props.anchored ? '--slot' : undefined;
const on = Astro.props.anchored ? '' : undefined;
---

{
  items.map(({ href, Icon, label, rel }) => (
    <span
      class={slot && 'rail-slot'}
      {...{ 'data-⚓️-name': slot, 'data-⚓️-scope-name': slot }}
    >
      <a
        aria-current={path === href ? 'page' : undefined}
        data-tip={on}
        {...{ 'data-⚓️-to': slot, 'data-⚓️-fill': on }}
        href={href}
        rel={rel}
      >
        <Icon />
        <span data-props-for={slot && 'truncated'}>{label}</span>
      </a>
    </span>
  ))
}
