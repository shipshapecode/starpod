---
import FullPlayButton from '../components/FullPlayButton';
import UFOIllustration from '../components/illustrations/UFOIllustration.astro';
import type { Episode, Show } from '../lib/rss';
import { dasherize } from '../utils/dasherize';
import { formatDuration, toPlayable } from '../utils/playable';

export interface Props {
  episodes: Array<Episode>;
  show: Show;
}

const { episodes, show } = Astro.props;
---

{
  episodes.length === 0 ? (
    <div class="empty">
      <div class="empty-art">
        <UFOIllustration />
      </div>
      <p>No episodes yet. The first one lands here the moment it’s in the feed.</p>
    </div>
  ) : (
    <ol aria-label="EpisodeList" class="episode-list">
      {episodes.map((episode) => {
        const date = new Date(episode.published);
        return (
          <li
            class="episode-row"
            data-episode-row
            data-vt={dasherize(episode.title)}
          >
            <img
              alt={`${episode.title} - episode art`}
              aria-hidden="true"
              class="episode-row-art"
              height={80}
              loading="lazy"
              src={episode.episodeThumbnail ?? show.image}
              width={80}
            />
            <div class="episode-row-main">
              <p class="episode-row-facts">
                <span class="episode-row-number">
                  {episode.episodeNumber === 'Bonus' ? 'Bonus' : episode.episodeNumber}
                </span>
                <time datetime={date.toISOString()}>
                  {date.toLocaleDateString('en-us', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                  })}
                </time>
                <span>{formatDuration(episode.duration)}</span>
                {episode.video && <span class="episode-row-kind">Video</span>}
              </p>
              <h3 class="episode-row-title">
                <a
                  href={`/${episode.episodeSlug}`}
                >
                  {episode.title}
                </a>
              </h3>
              <p class="episode-row-desc">{episode.description}</p>
            </div>
            <div class="episode-row-play">
              <FullPlayButton client:visible episode={toPlayable(episode, show)} />
            </div>
          </li>
        );
      })}
    </ol>
  )
}

<script>
  /*
    The row you open morphs into the episode page: its artwork into the
    cover, its title into the heading. Only that one row carries
    view-transition names (hundreds of named elements would be costly), set
    just before the navigation starts. Coming back, the row for the episode
    you left is named so both fly home.
  */
  const NAMED = 'data-vt-named';

  function name(row: HTMLElement | null) {
    document.querySelectorAll<HTMLElement>(`[${NAMED}]`).forEach((el) => {
      el.style.viewTransitionName = '';
      el.style.contentVisibility = '';
      el.removeAttribute(NAMED);
    });
    const slug = row?.dataset.vt;
    if (!row || !slug) {
      return;
    }
    // Rows skip rendering while off screen (content-visibility), and a row
    // just swapped in hasn't been judged on screen yet; a skipped element
    // can't be captured, so the named row always renders.
    row.style.contentVisibility = 'visible';
    row.setAttribute(NAMED, '');
    const art = row.querySelector<HTMLElement>('.episode-row-art');
    const title = row.querySelector<HTMLElement>('.episode-row-title a');
    for (const [el, value] of [
      [art, `vt-art-${slug}`],
      [title, `vt-${slug}`]
    ] as const) {
      if (el) {
        el.style.viewTransitionName = value;
        el.setAttribute(NAMED, '');
      }
    }
  }

  let leaving = '';

  document.addEventListener('astro:before-preparation', (event) => {
    leaving = event.from.pathname;
    const link = (event.sourceElement as HTMLElement | undefined)?.closest?.(
      '[data-episode-row] a[href]'
    );
    name(link ? (link.closest('[data-episode-row]') as HTMLElement) : null);
  });

  document.addEventListener('astro:after-swap', () => {
    const row = [...document.querySelectorAll<HTMLElement>('[data-episode-row]')].find(
      (candidate) =>
        candidate.querySelector('.episode-row-title a')?.getAttribute('href') === leaving
    );
    name(row ?? null);
  });
</script>
