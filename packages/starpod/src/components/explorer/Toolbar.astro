---
import { CloseIcon, ListIcon, SearchIcon } from '../icons';
import PersonFace from '../PersonFace.astro';
import type { ArchiveChoice } from './archive';
import { ChevronIcon, GridIcon, ResumeIcon, SortIcon, UpIcon } from './icons';

export interface Props {
  people: Array<ArchiveChoice>;
  total: number;
  years: Array<ArchiveChoice>;
}

const { people, total, years } = Astro.props;

const sorts = [
  { value: 'newest', label: 'Newest first' },
  { value: 'oldest', label: 'Oldest first' },
  { value: 'longest', label: 'Longest first' },
  { value: 'shortest', label: 'Shortest first' }
];

// Anchored auto layout attributes have an emoji in their name, which JSX
// can't spell; spread them in.
const segRoot = { 'data-⚓️-root': '', 'data-⚓️-scope-name': '--xp-on' };
const segThumb = {
  'data-⚓️-to': '--xp-on',
  'data-⚓️-fill': '',
  'data-⚓️-transition': 'glide'
};
---

<div
  class="xp-bar sticky top-(--xp-stick) z-20 mx-[calc(var(--gutter)*-1)] mt-0 mb-[22px] [container:xp-bar/scroll-state]"
  data-xp-bar
>
  <form
    aria-label="Filter episodes"
    class="xp-bar-in bg-ground/88 m-0 grid gap-2 px-(--gutter) py-3 backdrop-blur-[14px] backdrop-saturate-140 transition-[background-color,box-shadow] duration-300 ease-(--ease-out)"
    role="search"
  >
    <div class="xp-bar-row flex min-w-0 flex-wrap items-center gap-x-2.5 gap-y-2">
      <label
        class="xp-search border-line-strong bg-surface text-muted focus-within:border-accent focus-within:shadow-[0_0_0_4px_var(--accent-soft)] flex h-10 min-w-0 flex-[1_1_10rem] items-center gap-2 rounded-full border px-4 [transition:border-color_var(--quick),box-shadow_var(--quick)]"
      >
        <SearchIcon size={18} />
        <span class="sr-only">Search episodes</span>
        <input
          class="text-ink placeholder:text-muted h-full min-w-0 flex-1 border-0 bg-transparent p-0 text-[0.9375rem] leading-[inherit] font-[inherit] shadow-none outline-none [font-family:inherit] focus:ring-0 pointer-coarse:text-[max(1rem,16px)]"
          autocomplete="off"
          enterkeyhint="search"
          name="q"
          placeholder="Filter episodes"
          type="search"
        />
        <span aria-hidden="true" class="xp-count flex-none text-[0.8125rem] whitespace-nowrap text-muted">
          <b class="text-ink font-bold" data-xp-shown>{total}</b>
          <span data-xp-of hidden>of {total}</span>
          <span class="xp-count-unit">episodes</span>
        </span>
      </label>
      <fieldset class="xp-seg xp-views" {...segRoot}>
        <legend class="sr-only">View</legend>
        <span aria-hidden="true" class="xp-seg-thumb" {...segThumb}></span>
        <label>
          <input checked name="view" type="radio" value="grid" />
          <GridIcon size={18} />
          <span>Grid</span>
        </label>
        <label>
          <input name="view" type="radio" value="list" />
          <ListIcon size={18} />
          <span>List</span>
        </label>
      </fieldset>
      <button class="icon-button xp-top" data-xp-top type="button">
        <UpIcon />
        <span class="sr-only">Back to the top</span>
      </button>
    </div>

    <div
      class="xp-chips -my-1.5 mx-[calc(var(--gutter)*-1)] flex scroll-px-(--gutter) items-center gap-2 overflow-x-auto overscroll-x-contain px-(--gutter) py-1.5 [container:xp-chips/scroll-state] [scrollbar-width:none]"
    >
      <fieldset class="xp-seg" {...segRoot}>
        <legend class="sr-only">Kind</legend>
        <span aria-hidden="true" class="xp-seg-thumb" {...segThumb}></span>
        <label
          ><input checked name="kind" type="radio" value="" /><span>All</span
          ></label
        >
        <label
          ><input name="kind" type="radio" value="video" /><span>Video</span
          ></label
        >
        <label
          ><input name="kind" type="radio" value="audio" /><span>Audio</span
          ></label
        >
      </fieldset>
      <button
        aria-pressed="false"
        class="xp-pick halo"
        data-xp-progress
        hidden
        type="button"
      >
        <ResumeIcon size={18} />
        <span>In progress</span>
        <b data-xp-progress-count></b>
      </button>
      {
        /* A filter with a value set turns solid and gains a × that clears it. */
      }
      <span class="xp-filter relative inline-flex flex-none">
        <button
          class="xp-pick halo"
          popovertarget="xp-year"
          style="anchor-name: --xp-year"
          type="button"
        >
          <span>Year</span>
          <b data-xp-label="year">Any</b>
          <ChevronIcon class="xp-chevron" size={16} />
        </button>
        <button
          class="xp-unset bg-on-ink/16 text-on-ink hover:bg-on-ink/30 focus-visible:outline-accent absolute inset-y-2 end-2 grid w-6 cursor-pointer place-items-center rounded-[50%] border-0 p-0 [transition:background-color_var(--quick)] focus-visible:outline-2 focus-visible:outline-offset-2"
          data-xp-unset="year" hidden type="button">
          <CloseIcon size={14} />
          <span class="sr-only">Any year</span>
        </button>
      </span>
      {
        people.length > 0 && (
          <span class="xp-filter relative inline-flex flex-none">
            <button
              class="xp-pick halo"
              popovertarget="xp-people"
              style="anchor-name: --xp-people"
              type="button"
            >
              <span class="person-face xp-pick-face" data-xp-face hidden>
                <img alt="" height="20" src="data:," width="20" />
              </span>
              <span>With</span>
              <b data-xp-label="guest">Anyone</b>
              <ChevronIcon class="xp-chevron" size={16} />
            </button>
            <button
          class="xp-unset bg-on-ink/16 text-on-ink hover:bg-on-ink/30 focus-visible:outline-accent absolute inset-y-2 end-2 grid w-6 cursor-pointer place-items-center rounded-[50%] border-0 p-0 [transition:background-color_var(--quick)] focus-visible:outline-2 focus-visible:outline-offset-2"
          data-xp-unset="guest" hidden type="button">
              <CloseIcon size={14} />
              <span class="sr-only">Anyone</span>
            </button>
          </span>
        )
      }
      <button
        class="xp-reset text-accent-ink inline-flex h-10 flex-none cursor-pointer items-center gap-1.5 rounded-full border border-transparent bg-transparent px-[0.9rem] text-[0.8125rem] font-[650] whitespace-nowrap [transition:background-color_var(--quick),border-color_var(--quick),color_var(--quick)] [&:hover]:underline [&:hover]:underline-offset-[0.2em]"
        data-xp-reset
        hidden
        type="reset"
      >
        Reset
      </button>
      <button
        class="xp-pick xp-sort halo ml-auto"
        popovertarget="xp-sort"
        style="anchor-name: --xp-sort"
        type="button"
      >
        <SortIcon size={18} />
        <span class="sr-only">Sort:</span>
        <b data-xp-label="sort">Newest first</b>
        <ChevronIcon class="xp-chevron" size={16} />
      </button>
    </div>

    <div
      class="xp-menu text-text m-0 overflow-visible border-0 bg-transparent p-0"
      id="xp-sort"
      popover
      style="position-anchor: --xp-sort"
    >
      <div
        class="xp-menu-in border-line bg-surface relative min-w-60 origin-[34px_0] rounded-(--r-card) border shadow-(--shadow-float) [transition:opacity_calc(200ms*var(--slomo))_var(--ease-out),scale_calc(360ms*var(--slomo))_var(--ease-spring),translate_calc(360ms*var(--slomo))_var(--ease-out)]"
      >
        <fieldset
          class="xp-menu-list m-0 max-h-[min(420px,62dvh)] min-w-0 overflow-auto overscroll-contain rounded-[inherit] border-0 p-3"
        >
          <legend
            class="xp-menu-title text-muted float-left w-full px-3 pt-1 pb-1.5 text-[0.8125rem] font-semibold"
            >Sort episodes</legend>
          {
            sorts.map((sort, i) => (
              <label class="xp-option">
                <input
                  checked={i === 0}
                  name="sort"
                  type="radio"
                  value={sort.value}
                />
                <span>{sort.label}</span>
                <span aria-hidden="true" class="xp-radio" />
              </label>
            ))
          }
        </fieldset>
      </div>
    </div>

    <div
      class="xp-menu text-text m-0 overflow-visible border-0 bg-transparent p-0"
      id="xp-year"
      popover
      style="position-anchor: --xp-year"
    >
      <div
        class="xp-menu-in border-line bg-surface relative min-w-60 origin-[34px_0] rounded-(--r-card) border shadow-(--shadow-float) [transition:opacity_calc(200ms*var(--slomo))_var(--ease-out),scale_calc(360ms*var(--slomo))_var(--ease-spring),translate_calc(360ms*var(--slomo))_var(--ease-out)]"
      >
        <fieldset
          class="xp-menu-list m-0 max-h-[min(420px,62dvh)] min-w-0 overflow-auto overscroll-contain rounded-[inherit] border-0 p-3"
        >
          <legend
            class="xp-menu-title text-muted float-left w-full px-3 pt-1 pb-1.5 text-[0.8125rem] font-semibold"
            >Released in</legend>
          <label class="xp-option">
            <input checked name="year" type="radio" value="" />
            <span>Any year</span>
            <small>{total}</small>
            <span aria-hidden="true" class="xp-radio"></span>
          </label>
          {
            years.map((year) => (
              <label class="xp-option">
                <input name="year" type="radio" value={year.value} />
                <span>{year.label}</span>
                <small>{year.count}</small>
                <span aria-hidden="true" class="xp-radio" />
              </label>
            ))
          }
        </fieldset>
      </div>
    </div>

    {
      people.length > 0 && (
        <div
          class="xp-menu text-text m-0 overflow-visible border-0 bg-transparent p-0"
          id="xp-people"
          popover
          style="position-anchor: --xp-people"
        >
          <div
        class="xp-menu-in border-line bg-surface relative min-w-60 origin-[34px_0] rounded-(--r-card) border shadow-(--shadow-float) [transition:opacity_calc(200ms*var(--slomo))_var(--ease-out),scale_calc(360ms*var(--slomo))_var(--ease-spring),translate_calc(360ms*var(--slomo))_var(--ease-out)]"
      >
            <fieldset
          class="xp-menu-list m-0 max-h-[min(420px,62dvh)] min-w-0 overflow-auto overscroll-contain rounded-[inherit] border-0 p-3"
        >
              <legend
            class="xp-menu-title text-muted float-left w-full px-3 pt-1 pb-1.5 text-[0.8125rem] font-semibold"
            >Hosts and guests</legend>
              <label class="xp-option">
                <input checked name="guest" type="radio" value="" />
                <span>Anyone</span>
                <small>{total}</small>
                <span aria-hidden="true" class="xp-radio" />
              </label>
              {people.map((person) => (
                <label class="xp-option">
                  <input name="guest" type="radio" value={person.value} />
                  {person.avatar && (
                    <PersonFace size={32} src={person.avatar} />
                  )}
                  <span>{person.label}</span>
                  <small>{person.count}</small>
                  <span aria-hidden="true" class="xp-radio" />
                </label>
              ))}
            </fieldset>
          </div>
        </div>
      )
    }
  </form>
</div>
<p class="sr-only" data-xp-status role="status"></p>
