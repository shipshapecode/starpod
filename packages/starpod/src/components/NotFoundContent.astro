---
import FourZeroFourIllustration from './illustrations/404Illustration.astro';

const links = [
  { href: '/', label: 'All episodes' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/llms.txt', label: 'llms.txt' },
  { href: '/sitemap-index.xml', label: 'Sitemap' }
];
---

<div class="relative z-10 mx-auto flex max-w-xl flex-col items-center pb-16 text-center">
  <div class="w-full max-w-md">
    <FourZeroFourIllustration />
  </div>

  <h1
    class="text-ink mt-8 mb-0 font-(family-name:--font-display) text-[clamp(2rem,1.4rem+2vw,3rem)] leading-none font-extrabold tracking-snug text-balance uppercase [font-stretch:72%]"
  >
    Page not found
  </h1>
  <p class="text-text mt-3 mb-0">Looking for something? Try one of these:</p>

  <nav aria-label="Helpful links" class="nf-links mt-5">
    <ul class="m-0 flex list-none flex-wrap justify-center gap-x-6 gap-y-2 p-0 text-md leading-5 font-semibold">
      {
        links.map((link) => (
          <li>
            <a
              class="text-ink underline decoration-transparent underline-offset-4 transition-[text-decoration-color] duration-300 hover:decoration-current"
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <button class="button-secondary mt-8" onclick="history.back()" type="button">
    Go back
  </button>
</div>
