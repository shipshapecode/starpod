---
import { matchNames, sortCast, voiceFor, type CastPerson } from '../lib/cast';
import { getEpisodeCues } from '../lib/episode-cues';
import { faceOf } from '../lib/people';
import { optimizeImage } from '../lib/optimize-episode-image';
import type { Episode, Show } from '../lib/rss';
import { dasherize } from '../utils/dasherize';
import { formatDuration, toPlayable } from '../utils/playable';
import { ArrowOutIcon, HeadphonesIcon, VideoIcon } from './icons';
import Sponsors from './episode/Sponsors.astro';
import LiveScript from './media/LiveScript';
import PersonFace from './PersonFace.astro';
import StageControls from './media/StageControls';

import starpodConfig from 'virtual:starpod/config';

export interface Props {
  episode: Episode;
  show: Show;
  /**
   * The episode's hosts and guests, from the guests/sponsors database. Empty
   * (or absent) when the database isn't enabled: no cast is shown.
   */
  people?: Array<CastPerson>;
  /** The episode's sponsors from the database; the row hides when empty. */
  sponsors?: Array<{ id: string; img: string | null; name: string; url: string }>;
  /** `feature` on the home page (links on to the episode), `page` on its own page. */
  variant: 'feature' | 'page';
  /**
   * Divide the stage between the picture and the live transcript with a
   * draggable divider (desktop, when the episode has a transcript). See
   * `episode/split.ts`.
   */
  split?: boolean;
}

const { episode, people = [], show, sponsors = [], split = false, variant } = Astro.props;
const playable = toPlayable(episode, show);
const Heading = variant === 'page' ? 'h1' : 'h2';
const art =
  (await optimizeImage(episode.episodeImage ?? show.image, { width: 960, height: 960 })) ??
  show.image;
const date = new Date(episode.published);
const titleId = `stage-title-${episode.id.replace(/[^a-z0-9]/gi, '')}`;
const scriptId = `stage-script-${episode.id.replace(/[^a-z0-9]/gi, '')}`;
const presets = [
  ['watch', 'Watch'],
  ['balanced', 'Balanced'],
  ['read', 'Read']
];

// The cast: this episode's own hosts and guests, in credit order. Anyone who
// speaks as one of the transcript's two main voices wears that voice's face.
const cues = people.length ? await getEpisodeCues(episode) : null;
const names = people.map((person) => person.name);
const speakerOf = matchNames(names, [...new Set(cues?.flatMap((cue) => (cue.n ? [cue.n] : [])))], {
  surnames: true
});
const cast = await Promise.all(
  sortCast(people, starpodConfig.hosts.map((host) => host.name)).map(async (person) => {
    return {
      guest: !person.isHost,
      name: person.name,
      speaksAs: speakerOf.get(person.name),
      src: await faceOf(person.img, 112),
      voice: voiceFor(person.name, cues, names)
    };
  })
);
---

<!-- Islands that are direct stage children take part in its grid
     ([&>astro-island]:contents). -->
<section
  aria-labelledby={titleId}
  class="stage mb-[clamp(40px,6vw,80px)] grid grid-cols-[minmax(0,1fr)] gap-5 [grid-template-areas:'frame'_'meta'_'script'] [&>astro-island]:contents"
  data-has-video={episode.video ? '' : undefined}
  data-split={split ? '' : undefined}
  data-stage
  data-variant={variant}
>
  <div class="stage-side">
  <div class="stage-room relative min-w-0 [grid-area:frame]">
  <div aria-hidden="true" class="stage-light" style={`--art: url("${art}")`}>
    <canvas
      class="stage-light-canvas"
      data-episode-id={episode.id}
      data-stage-light
      height="18"
      width="32"
    ></canvas>
  </div>
  <div class="stage-frame PropFLIP relative isolate aspect-video overflow-hidden bg-media-ground shadow-[var(--shadow-soft)]" data-stage-frame>
    <!-- The artwork, at home on its own colour field: the fallback stage for
         audio-only episodes and for anyone choosing to listen. -->
    <div
      aria-hidden="true"
      class="absolute inset-[-12%] bg-(image:--art) bg-cover bg-center [filter:blur(48px)_saturate(1.35)_brightness(0.55)] [transform:scale(1.1)]"
      style={`--art: url("${art}")`}></div>
    <img
      alt={`${episode.title} - episode art`}
      class="stage-art absolute top-1/2 left-1/2 aspect-square h-[74%] w-auto rounded-[calc(var(--radius-frame)-2px)] object-cover shadow-[var(--shadow-float)] -translate-1/2 [transition:scale_700ms_var(--ease-out),opacity_500ms_var(--ease-out)]"
      decoding="async"
      fetchpriority="high"
      height="960"
      src={art}
      style={`view-transition-name: vt-art-${dasherize(episode.title)}`}
      width="960"
    />
    <div class="stage-slot absolute inset-0 z-1" data-episode-id={episode.id} data-media-slot></div>
    <StageControls client:load episode={playable} part="overlay" />
  </div>
  </div>

  <div class="stage-meta min-w-0 [grid-area:meta]">
    <Heading
      class="stage-title mb-3 max-w-[22ch] font-(family-name:--font-display) text-[length:clamp(1.75rem,1.1rem+2.4vw,3.25rem)] leading-[1.04] font-bold tracking-[-0.025em]"
      id={titleId}
      style={`view-transition-name: vt-${dasherize(episode.title)}`}
    >
      {episode.title}
    </Heading>
    <p
      class="stage-facts mb-4 flex flex-wrap items-center gap-x-4 gap-y-[0.3rem] overflow-hidden text-[0.875rem] text-muted"
    >
      <span>{episode.episodeNumber === 'Bonus' ? 'Bonus' : `Episode ${episode.episodeNumber}`}</span>
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('en-us', { month: 'short', day: 'numeric', year: 'numeric' })}
      </time>
      <span>{formatDuration(episode.duration)}</span>
      <span class="stage-kind inline-flex items-center gap-[0.35rem] font-[650] text-accent-ink">
        {episode.video ? <VideoIcon size={15} /> : <HeadphonesIcon size={15} />}
        {episode.video ? 'Video' : 'Audio'}
      </span>
    </p>
    {
      cast.length > 0 && (
        <ul aria-label="Creators and guests" class="cast mb-5 hidden flex-wrap gap-x-[22px] gap-y-2.5">
          {cast.map((person) => (
            <li
              class="cast-member flex items-center gap-2.5"
              data-speaks-as={person.speaksAs}
              data-voice={person.voice ?? 'none'}
            >
              <PersonFace src={person.src} />
              <span class="flex flex-col leading-tight">
                <span class="cast-name text-ink font-semibold">{person.name}</span>
                <span class="text-muted text-xs font-semibold">
                  {person.guest ? 'Guest' : 'Host'}
                </span>
              </span>
            </li>
          ))}
        </ul>
      )
    }
    <Sponsors sponsors={sponsors} />
    <p class="stage-desc mb-5 max-w-[62ch] text-[1.0625rem] text-text">{episode.description}</p>
    <StageControls client:load episode={playable} part="actions" />
    {
      variant === 'feature' && (
        <a class="link-on mt-[1.1rem] inline-flex items-center gap-[0.35rem] font-[650] no-underline" href={`/${episode.episodeSlug}`}>
          Show notes and transcript
          <ArrowOutIcon size={16} />
        </a>
      )
    }
  </div>
  </div>

  {
    split && (
      <div
        aria-controls={scriptId}
        aria-label="Resize the picture and the transcript"
        aria-orientation="vertical"
        aria-valuemax="100"
        aria-valuemin="0"
        class="ep-split PropFLIP"
        role="separator"
        tabindex="0"
        {...{ 'data-⚓️-name': '--ep-split' }}
      />
    )
  }

  <div class="stage-script min-w-0 [grid-area:script]" id={scriptId}>
    {
      split && (
        <div
          aria-label="Stage layout"
          class="ep-presets"
          role="group"
          {...{ 'data-⚓️-root': '', 'data-⚓️-scope-name': '--ep-on' }}
        >
          <i
            aria-hidden="true"
            class="ep-presets-on"
            {...{ 'data-⚓️-to': '--ep-on', 'data-⚓️-fill': '' }}
          />
          {presets.map(([key, label]) => (
            <button aria-pressed="false" data-preset={key} type="button">
              {label}
            </button>
          ))}
        </div>
      )
    }
    <LiveScript client:only="preact" episode={playable} />
  </div>

</section>
