---
import starpodConfig from 'virtual:starpod/config';
import AppleIcon from '../svgs/apple.svg?raw';
import OvercastIcon from '../svgs/overcast.svg?raw';
import PocketCastsIcon from '../svgs/pocket-casts.svg?raw';
import SpotifyIcon from '../svgs/spotify.svg?raw';
import YouTubeIcon from '../svgs/youtube.svg?raw';

const { platforms, rssFeed } = starpodConfig;

const RssIcon = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path class="fill-muted" d="M4 10.5a9.5 9.5 0 0 1 9.5 9.5H11a7 7 0 0 0-7-7zM4 4a16 16 0 0 1 16 16h-2.5A13.5 13.5 0 0 0 4 6.5z"/><circle class="fill-muted" cx="5.6" cy="18.4" r="2"/></svg>`;

const entries = [
  platforms?.apple && { href: platforms.apple, icon: AppleIcon, label: 'Apple Podcasts' },
  platforms?.spotify && { href: platforms.spotify, icon: SpotifyIcon, label: 'Spotify' },
  platforms?.youtube && { href: platforms.youtube, icon: YouTubeIcon, label: 'YouTube' },
  platforms?.overcast && { href: platforms.overcast, icon: OvercastIcon, label: 'Overcast' },
  platforms?.pocketCasts && {
    href: platforms.pocketCasts,
    icon: PocketCastsIcon,
    label: 'Pocket Casts'
  },
  rssFeed && { href: rssFeed, icon: RssIcon, label: 'RSS feed' }
].filter(Boolean) as Array<{ href: string; icon: string; label: string }>;
---

<ul class="m-0 flex list-none flex-wrap gap-3 p-0">
  {
    entries.map((entry) => (
      <li>
        <a
          class="halo text-ink border-line inline-flex items-center gap-2.5 rounded-full border py-2.5 pr-5 pl-4 text-base font-semibold no-underline"
          href={entry.href}
        >
          <span aria-hidden="true" class="flex size-4.5 items-center [&>svg]:size-full">
            <Fragment set:html={entry.icon} />
          </span>
          {entry.label}
        </a>
      </li>
    ))
  }
</ul>
