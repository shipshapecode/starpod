---
export interface Props {
  bullets: Array<string>;
  heading: string;
  price: string;
}

const { bullets, heading, price } = Astro.props;
---

<div class="bg-surface relative z-10 mb-6 rounded-card p-1">
  <h2
    class="bg-raised text-ink rounded-tray px-5 py-4 font-bold lg:py-6"
  >
    {heading}
  </h2>

  <ul class="list-disc px-5 sm:px-8">
    {
      bullets.map((bullet) => {
        return <li class="border-line border-b py-6">{bullet}</li>;
      })
    }

    <h3
      class="text-ink mt-8 mb-12 text-[2.25rem] leading-10 font-bold tabular-nums sm:px-5"
    >
      {price}
      <span
        class="text-text text-[1.875rem] leading-9 font-light"
      >
        /
      </span>
      <span class="text-text text-[1.5rem] leading-8">
        per episode
      </span>
    </h3>

    <div class="flex w-full">
      <a class="btn mb-8 w-full justify-center" href="/contact">
        <span
          class="text-ink rounded-full px-8 py-3 text-center text-md leading-5"
        >
          Become a sponsor
        </span>
      </a>
    </div>
  </ul>
</div>
