---
export interface Props {
  image: string;
}

const { image } = Astro.props;
---

<!-- Leans toward the pointer (styles/tilt.css): CSS reading prop-for-that's
     pointer-local ratios, bound only while hovered (data-props-hover, in
     Layout.astro), so it costs nothing at rest, off screen, or while the
     pointer is elsewhere on the page. -->
<a
  aria-label="Homepage"
  class="show-art tilt w-full"
  data-props-hover="pointer-local"
  href="/"
>
  <span class="tilt-body overflow-hidden rounded-xl shadow-[var(--shadow-soft)]">
    <img
      alt=""
      class="block w-full rounded-xl"
      fetchpriority="high"
      height="320"
      loading="eager"
      src={image}
      width="320"
    />
  </span>
</a>
