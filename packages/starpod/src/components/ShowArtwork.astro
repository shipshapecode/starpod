---
export interface Props {
  image: string;
}

const { image } = Astro.props;
---

<a aria-label="Homepage" class="block w-18" href="/">
  <div class="atropos show-art">
    <div class="atropos-scale">
      <div class="atropos-rotate">
        <div class="atropos-inner rounded-xl shadow-[var(--shadow-soft)]">
          <img
            alt=""
            class="block w-full rounded-xl"
            fetchpriority="high"
            height="320"
            loading="eager"
            src={image}
            width="320"
          />
        </div>
      </div>
    </div>
  </div>
</a>

<script>
  import Atropos from 'atropos';

  // Re-run after client-side navigation: the rail is re-rendered per page.
  const tilt = () => {
    document.querySelectorAll<HTMLElement>('.show-art:not([data-tilt])').forEach((el) => {
      el.dataset.tilt = '';
      Atropos({ el });
    });
  };
  tilt();
  document.addEventListener('astro:page-load', tilt);
</script>
