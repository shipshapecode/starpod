---
export interface Props {
  sponsors: Array<{
    id: string;
    img: string | null;
    name: string;
    url: string;
  }>;
}

const { sponsors } = Astro.props;
const svgs = import.meta.glob('/src/img/sponsors/*.svg', {
  query: '?raw',
  import: 'default'
});
---

{
  sponsors.length > 0 && (
    <div class="mb-5">
      <p class="text-muted mb-2 text-xs font-semibold tracking-wide uppercase">Presented by</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-3">
        {sponsors.map((sponsor) => (
          <li>
            <a
              class="text-ink group flex items-center gap-2.5 font-semibold"
              href={sponsor.url}
              rel="noopener"
              target="_blank"
            >
              <span class="size-8 shrink-0 overflow-hidden rounded-md [&>svg]:size-full">
                <Fragment set:html={svgs[`/src/img/sponsors/${sponsor.img}`]?.() ?? ''} />
              </span>
              <span class="underline decoration-transparent underline-offset-4 transition-[text-decoration-color] duration-300 group-hover:decoration-current">
                {sponsor.name}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
