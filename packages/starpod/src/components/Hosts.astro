---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import starpodConfig from 'virtual:starpod/config';

import avatar from '../assets/avatar.svg?url';

export interface Props {
  /**
   * In the desktop rail: each host is a slot, and the face (the shared
   * people identity, styles/people.css) and name are pieces anchored to it,
   * so the faces can gather into a stack: a co-author credit at rest in the
   * open rail, a column of marks in the icon rail.
   */
  anchored?: boolean;
}

const { anchored } = Astro.props;
const { hosts } = starpodConfig;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/img/people/*.{jpeg,jpg,png}'
);

// Fall back to the packaged avatar, which follows light and dark, when the
// site has not provided a photo in src/img/people yet.
const hostImage = (img: string) =>
  images[`/src/img/people/${img}`] as (typeof images)[string] | undefined;

const slot = anchored ? '--slot' : undefined;
const on = anchored ? '' : undefined;
// Each host links to their own site, else a profile.
const linkFor = (host: (typeof hosts)[number]) =>
  host.website ?? host.twitter ?? host.github;
// The stack's credit line, the way a co-authored post is signed.
const first = (name: string) => name.split(/\s+/)[0];
// Fanned out for good with one host, or with more than two and nothing to
// focus: the credit names only two, and a keyboard (with no link to land
// on) could never fan the stack to read the rest.
const fanned = hosts.length === 1 || (hosts.length > 2 && !hosts.some(linkFor));
const credit =
  hosts.length === 2
    ? `${hosts[0]!.name} & ${hosts[1]!.name}`
    : hosts.length > 2
      ? `${first(hosts[0]!.name)}, ${first(hosts[1]!.name)} and ${hosts.length - 2} more`
      : '';
---

<div
  class:list={[anchored && 'rail-hosts-in', fanned && 'is-fanned']}
  style={anchored ? `--hosts: ${hosts.length}` : undefined}
>
  <h3
    class:list={[anchored ? 'rail-label' : 'rail-fly-title']}
    {...{
      'data-⚓️-to': anchored ? '--rail-hosts' : undefined,
      'data-⚓️-above': on,
      'data-⚓️-align-leading': on
    }}
  >
    Hosted by
  </h3>

  <div
    class:list={[
      'host-list',
      anchored &&
        'lg:mt-[26px] lg:flex lg:min-h-[calc(var(--hosts,1)*46px-6px)] lg:items-start'
    ]}
    {...{ 'data-⚓️-name': anchored ? '--rail-hosts' : undefined }}
  >
    {
      hosts.map((host, index) => {
        const href = linkFor(host);
        const photo = hostImage(host.img);
        const Row = href ? 'a' : 'div';
        return (
          <Row
            class:list={[
              'host-row text-ink mb-3 flex items-center font-semibold',
              anchored &&
                'rail-host lg:m-0 lg:block lg:size-10 lg:flex-none lg:rounded-[50%] lg:[transition:background-color_var(--quick)]'
            ]}
            data-speaks-as={host.name}
            data-voice={index < 2 ? index : undefined}
            href={href}
            {...{ 'data-⚓️-name': slot, 'data-⚓️-scope-name': slot }}
          >
            <span
              class="person-face"
              {...{
                'data-⚓️-to': slot,
                'data-⚓️-align-top': on,
                'data-⚓️-align-leading': on
              }}
            >
              {photo ? (
                <Image
                  alt=""
                  height={40}
                  loading="lazy"
                  src={photo()}
                  width={40}
                />
              ) : (
                <img
                  alt=""
                  height={40}
                  loading="lazy"
                  src={avatar}
                  width={40}
                />
              )}
            </span>
            <span
              class={
                slot &&
                'rail-host-name lg:pointer-events-none lg:mt-2.5 lg:ml-13 lg:whitespace-nowrap lg:opacity-0'
              }
              {...{
                'data-⚓️-to': slot,
                'data-⚓️-align-top': on,
                'data-⚓️-align-leading': on
              }}
            >
              {host.name}
              <span class="person-speaking">Speaking</span>
            </span>
          </Row>
        );
      })
    }
  </div>

  {
    anchored && credit && (
      <p
        aria-hidden="true"
        class="host-credit lg:text-ink lg:pointer-events-none lg:box-border lg:flex lg:min-h-10 lg:items-center lg:text-[0.8125rem] lg:leading-[1.25] lg:font-[650] lg:text-balance"
        {...{
          'data-⚓️-to': '--rail-hosts',
          'data-⚓️-align-top': '',
          'data-⚓️-align-leading': ''
        }}
      >
        {credit}
      </p>
    )
  }
</div>
