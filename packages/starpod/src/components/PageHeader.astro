---
/**
 * The opening of a standalone page (About, Contact, …): the stage's condensed
 * display heading, with an optional lede in the default slot.
 */
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="mb-10 lg:mb-14">
  <h1
    class="text-ink max-w-headline tracking-snug m-0 font-(family-name:--font-display) text-[clamp(2.25rem,1.4rem+3vw,4rem)] leading-[0.95] font-extrabold text-balance uppercase [font-stretch:72%]"
  >
    {title}
  </h1>
  {
    Astro.slots.has('default') && (
      <div class="text-text mt-5 max-w-[62ch] text-2xl leading-[1.625] text-pretty">
        <slot />
      </div>
    )
  }
</header>
