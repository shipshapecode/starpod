---
import { getEntry, render } from 'astro:content';
import { count, eq, inArray } from 'drizzle-orm';

import { createDb } from '../db';
import { Episode as DbEpisode, Sponsor, SponsorForEpisode } from '../db/schema';

import { Schema } from 'astro-seo-schema';

import BarPlay from '../components/episode/BarPlay';
import MarkdownTranscript from '../components/episode/MarkdownTranscript';
import Onward from '../components/episode/Onward.astro';
import People from '../components/episode/People.astro';
import SectionBar from '../components/episode/SectionBar.astro';
import SponsorCards from '../components/episode/SponsorCards.astro';
import RssTranscript from '../components/episode/Transcript';
import EpisodeStage from '../components/EpisodeStage.astro';
import ShowNotes from '../components/episode/ShowNotes';
import UFOIllustration from '../components/illustrations/UFOIllustration.astro';
import { generateDocumentLinkTag } from '@bryanguffey/astro-standard-site';

import starpodConfig, { database } from 'virtual:starpod/config';

import Layout from '../layouts/Layout.astro';
import { factGivesCount, matchNames, personFact, sortCast } from '../lib/cast';
import { getEpisodeCues } from '../lib/episode-cues';
import { optimizeImage } from '../lib/optimize-episode-image';
import { faceOf, peopleBySlug } from '../lib/people';
import { getAllEpisodes, getShowInfo, type Episode } from '../lib/rss';
import {
  getRssTranscriptParagraphs,
  type TranscriptParagraph
} from '../lib/transcript';
import { getDocumentRkeys } from '../lib/standardSite';
import { toPlayable } from '../utils/playable';

const show = await getShowInfo();

export async function getStaticPaths() {
  const allEpisodes = await getAllEpisodes();

  return allEpisodes.flatMap((episode) => {
    return [
      {
        params: { episode: episode.episodeNumber },
        props: { episode }
      },
      {
        params: { episode: episode.episodeSlug },
        props: { episode }
      }
    ];
  });
}

const { episode } = Astro.props;

let Transcript;
let rssTranscript: Array<TranscriptParagraph> | null = null;

if (episode.episodeNumber && episode.episodeNumber !== 'Bonus') {
  Transcript = await getEntry('transcripts', episode.episodeNumber);
  if (Transcript) {
    const { Content } = await render(Transcript);
    Transcript = Content;
  }
}

// Fall back to the transcript referenced by the RSS feed's
// `<podcast:transcript>` tag when no explicit markdown transcript was provided.
if (!Transcript) {
  rssTranscript = await getRssTranscriptParagraphs(episode);
}

const hasTranscript = Boolean(Transcript) || Boolean(rssTranscript?.length);

// Who speaks, by the names the transcript gives: their voice, when they are
// first heard, and how much of the talking is theirs.
const cues = hasTranscript ? ((await getEpisodeCues(episode)) ?? []) : [];
const talk = new Map<string, { chars: number; first: number; voice?: number }>();
for (const cue of cues) {
  if (cue.n) {
    const said = talk.get(cue.n) ?? { chars: 0, first: cue.s, voice: cue.v };
    said.chars += cue.t.length;
    talk.set(cue.n, said);
  }
}
const talked = [...talk.values()].reduce((sum, said) => sum + said.chars, 0);

// Speakers in the transcript's gutter speak in the stage's voices: the two who
// talk most in their own faces, everyone else in the plain gutter style.
const speakerVoices = new Map(
  Transcript
    ? [...talk]
        .filter(([, said]) => said.voice !== undefined && said.voice < 2)
        .map(([name, said]) => [name, said.voice!])
    : []
);
const voiceCss = [...speakerVoices]
  .map(([name, voice]) => {
    const value = name.replace(
      /["\\<]/g,
      (c) => `\\${c.charCodeAt(0).toString(16)} `
    );
    return `.ep-turn-head[data-speaker="${value}"]{--ep-voice:${voice}}`;
  })
  .join('');

// The subset of episode fields the player needs, shared by both transcript
// timestamp variants so clicking one can load this episode.
const playerEpisode = toPlayable(episode, show);

const canonicalURL = new URL(`/${episode.episodeSlug}`, Astro.url);

// The guests/sponsors database is opt-in via the integration's `database`
// option; without it the page renders with those sections absent.
const db = database
  ? createDb(
      import.meta.env.ASTRO_DB_REMOTE_URL,
      import.meta.env.ASTRO_DB_APP_TOKEN
    )
  : null;

// Its hosts and guests: the database's, else the feed's (src/lib/people.ts).
const castBySlug = await peopleBySlug();
const hostsAndGuests = castBySlug.get(episode.episodeSlug) ?? [];

const sponsors = !db
  ? []
  : await db
      .select({
        id: Sponsor.id,
        img: Sponsor.img,
        name: Sponsor.name,
        url: Sponsor.url
      })
      .from(SponsorForEpisode)
      .innerJoin(
        DbEpisode,
        eq(SponsorForEpisode.episodeSlug, DbEpisode.episodeSlug)
      )
      .innerJoin(Sponsor, eq(SponsorForEpisode.sponsorId, Sponsor.id))
      .where(eq(DbEpisode.episodeSlug, episode.episodeSlug));

const title = `${episode.title} - ${show.title} - Episode ${episode.episodeNumber}`;

// Onward: the episodes either side of this one in the feed, every episode
// this episode's people are on, and how many episodes each sponsor presented.
const allEpisodes = await getAllEpisodes();
const position = allEpisodes.findIndex((item) => item.id === episode.id);
const newer = allEpisodes[position - 1];
const older = allEpisodes[position + 1];
const bySlug = new Map(allEpisodes.map((item) => [item.episodeSlug, item]));

const episodesOf = (personId: string) =>
  [...castBySlug]
    .filter(([, people]) => people.some((person) => person.id === personId))
    .map(([slug]) => bySlug.get(slug))
    .filter((item): item is Episode => Boolean(item))
    .sort((a, b) => b.published - a.published);

const presented = new Map(
  !db || !sponsors.length
    ? []
    : (
        await db
          .select({ id: SponsorForEpisode.sponsorId, episodes: count() })
          .from(SponsorForEpisode)
          .where(
            inArray(
              SponsorForEpisode.sponsorId,
              sponsors.map((sponsor) => sponsor.id)
            )
          )
          .groupBy(SponsorForEpisode.sponsorId)
      ).map((row) => [row.id, row.episodes])
);

const numberOf = (item: Episode) =>
  item.episodeNumber === 'Bonus' ? 'Bonus' : `Ep ${item.episodeNumber}`;
const card = async (item: Episode, reason?: string, face?: string) => ({
  href: `/${item.episodeSlug}`,
  number: numberOf(item),
  title: item.title,
  art:
    (await optimizeImage(item.episodeImage ?? show.image, {
      width: 320,
      height: 320
    })) ?? show.image,
  duration: item.duration,
  reason,
  face
});

const cast = sortCast(
  hostsAndGuests,
  starpodConfig.hosts.map((host) => host.name)
);
// Who in the cast is which of the transcript's speakers: one each, the
// surest first, so a guest never takes a host's lines for sharing a surname.
const speakerOf = matchNames(
  cast.map((person) => person.name),
  [...talk.keys()],
  { surnames: true }
);
const people = await Promise.all(
  cast.map(async (person) => {
    const theirs = episodesOf(person.id);
    // Which of their episodes this is, oldest first.
    const newest = theirs.findIndex((item) => item.id === episode.id);
    const appearance = newest === -1 ? undefined : theirs.length - newest;
    const earliest = theirs.at(-1);
    const speaker = speakerOf.get(person.name);
    const said = speaker ? talk.get(speaker) : undefined;
    return {
      id: person.id,
      name: person.name,
      guest: !person.isHost,
      src: await faceOf(person.img, 128),
      count: theirs.length,
      fact: personFact({
        appearance,
        count: theirs.length,
        first: earliest && numberOf(earliest),
        host: person.isHost
      }),
      counted: factGivesCount({
        appearance,
        count: theirs.length,
        host: person.isHost
      }),
      voice:
        said?.voice !== undefined && said.voice < 2 ? said.voice : undefined,
      speaksAs: speaker,
      firstLine: said?.first,
      share: said && talked ? said.chars / talked : undefined,
      others: await Promise.all(
        theirs
          .filter((item) => item.id !== episode.id)
          .slice(0, 4)
          .map(async (item) => {
            const { art, href, number, title } = await card(item);
            return { art, href, number, title };
          })
      )
    };
  })
);

// The person behind each name the transcript gives its speakers.
const speakers = Object.fromEntries(
  [...talk.keys()].flatMap((speaker) => {
    const person = people.find((candidate) => candidate.speaksAs === speaker);
    return person
      ? [
          [
            speaker,
            {
              fact: person.fact,
              name: person.name,
              src: person.src,
              voice: person.voice
            }
          ]
        ]
      : [];
  })
);

// Related: the guests' other episodes first, then neighbours in time.
const seen = new Set([episode.id, newer?.id, older?.id]);
const relatedEpisodes: Array<[Episode, string?, string?]> = [];
for (const guest of people.filter((person) => person.guest)) {
  for (const item of episodesOf(guest.id)) {
    if (!seen.has(item.id)) {
      seen.add(item.id);
      relatedEpisodes.push([item, `With ${guest.name}`, guest.src]);
    }
  }
}
for (
  let step = 2;
  relatedEpisodes.length < 10 && step < allEpisodes.length;
  step++
) {
  for (const item of [
    allEpisodes[position + step],
    allEpisodes[position - step]
  ]) {
    if (item && !seen.has(item.id)) {
      seen.add(item.id);
      relatedEpisodes.push([item]);
    }
  }
}
const related = await Promise.all(
  relatedEpisodes
    .slice(0, 10)
    .map(([item, reason, face]) => card(item, reason, face))
);
const newerCard = newer && (await card(newer));
const olderCard = older && (await card(older));
// A show's only episode has nowhere onward to go: no section, no link to it.
const hasOnward = Boolean(newerCard || olderCard || related.length);

const sections = [
  { id: 'notes', label: 'Notes' },
  people.length && { id: 'people', label: 'People' },
  sponsors.length && { id: 'sponsors', label: 'Sponsors' },
  hasTranscript && { id: 'transcript', label: 'Transcript' },
  hasOnward && { id: 'more', label: 'More episodes' }
].filter((section) => !!section);

// standard.site document verification: link this page to its published ATProto
// `site.standard.document` record so shared links can be verified as ours.
const standardSiteDid = import.meta.env.STANDARD_SITE_DID;
const documentRkey = (await getDocumentRkeys()).get(`/${episode.episodeSlug}`);
const documentLinkTag =
  standardSiteDid && documentRkey
    ? generateDocumentLinkTag({ did: standardSiteDid, documentRkey })
    : null;
---

<Layout
  canonicalURL={canonicalURL}
  description={episode.description}
  imageUrl={episode.episodeImage}
  title={title}
>
  <Schema
    slot="head"
    item={{
      '@context': 'https://schema.org',
      '@type': 'PodcastEpisode',
      name: episode.title,
      datePublished: new Date(episode.published).toISOString(),
      description: episode.description,
      episodeNumber: episode.episodeNumber,
      url: canonicalURL.toString(),
      image: episode.episodeImage || show.image,
      duration: `PT${Math.floor(episode.duration / 60)}M${episode.duration % 60}S`,
      associatedMedia: {
        '@type': 'MediaObject',
        contentUrl: episode.audio?.src,
        encodingFormat: episode.audio?.type || 'audio/mpeg'
      },
      partOfSeries: {
        '@type': 'PodcastSeries',
        name: show.title,
        url: Astro.site?.toString()
      }
    }}
  />

  {documentLinkTag && <Fragment slot="head" set:html={documentLinkTag} />}
  {voiceCss && <style is:inline slot="head" set:html={voiceCss} />}

  <!-- Enhanced Open Graph tags -->
  <meta slot="head" property="og:audio" content={episode.audio?.src} />
  <meta
    slot="head"
    property="article:published_time"
    content={new Date(episode.published).toISOString()}
  />
  {
    hostsAndGuests
      ?.filter((p) => p.isHost)
      .map((host) => (
        <meta slot="head" property="article:author" content={host.name} />
      ))
  }

  <EpisodeStage
    episode={episode}
    people={hostsAndGuests}
    show={show}
    split={hasTranscript}
    sponsors={sponsors}
    variant="page"
  />

  <div class="ep-body">
    <SectionBar label="Episode sections" sections={sections}>
      <BarPlay client:load episode={playerEpisode} />
      <a class="ep-bar-title flex min-w-0 flex-col leading-[1.2] no-underline max-sm:hidden" href="#main">
        <span class="text-[0.75rem] font-semibold tabular-nums text-muted">{numberOf(episode)}</span>
        <span class="ep-bar-name truncate text-[0.875rem] font-bold">{episode.title}</span>
      </a>
    </SectionBar>

    <section
      aria-labelledby="notes-heading"
      class="ep-section notes"
      id="notes"
    >
      <h2 class="section-title ep-reveal" id="notes-heading">Show notes</h2>
      <div class="ep-clamp-box relative">
        <div
          class="ep-clamp"
          data-clamped
          data-props-for="truncated"
          data-props-to=".notes"
        >
          <ShowNotes client:visible episode={playerEpisode}>
            <Fragment set:html={episode.content} />
          </ShowNotes>
        </div>
        <button
          class="button-secondary halo ep-more"
          data-ep-expand
          type="button"
        >
          Show all notes
        </button>
      </div>
    </section>

    {
      people.length > 0 && (
        <section
          aria-labelledby="people-heading"
          class="ep-section"
          id="people"
        >
          <h2 class="section-title ep-reveal" id="people-heading">
            People <span class="section-count">{people.length}</span>
          </h2>
          <People episode={playerEpisode} people={people} />
        </section>
      )
    }

    {
      sponsors.length > 0 && (
        <section
          aria-labelledby="sponsors-heading"
          class="ep-section"
          id="sponsors"
        >
          <h2 class="section-title ep-reveal" id="sponsors-heading">
            Presented by
          </h2>
          <SponsorCards
            sponsors={sponsors.map((sponsor) => ({
              ...sponsor,
              count: presented.get(sponsor.id) ?? 1
            }))}
          />
        </section>
      )
    }

    <section
      aria-labelledby="transcript-heading"
      class="ep-section transcript-section max-w-[82ch]"
      id="transcript"
    >
      <h2 class="section-title ep-reveal" id="transcript-heading">
        Transcript
      </h2>
      {
        hasTranscript ? (
          <div class="ep-clamp-box relative">
            <Schema
              item={{
                '@context': 'https://schema.org',
                '@type': 'Article',
                headline: `${episode.title} - Episode Transcript`,
                datePublished: new Date(episode.published).toISOString(),
                author: {
                  '@type': 'Organization',
                  name: show.title
                },
                publisher: {
                  '@type': 'Organization',
                  name: show.title
                },
                mainEntityOfPage: {
                  '@type': 'WebPage',
                  '@id': canonicalURL.toString()
                },
                about: {
                  '@type': 'PodcastEpisode',
                  name: episode.title,
                  episodeNumber: episode.episodeNumber
                }
              }}
            />
            {Transcript ? (
              <MarkdownTranscript
                client:load
                episode={playerEpisode}
                speakers={speakers}
              >
                <Transcript />
              </MarkdownTranscript>
            ) : (
              <RssTranscript
                client:load
                episode={playerEpisode}
                paragraphs={rssTranscript!}
              />
            )}

            <button
              class="button-secondary halo ep-more"
              data-ep-expand
              type="button"
            >
              Read the full transcript
            </button>
          </div>
        ) : (
          <div class="empty">
            <div class="empty-art">
              <UFOIllustration />
            </div>
            <p>No transcript for this one yet. Press play and hear it straight from the source.</p>
          </div>
        )
      }
    </section>

    {
      hasOnward && (
        <section aria-labelledby="more-heading" class="ep-section" id="more">
          <h2 class="section-title ep-reveal" id="more-heading">More episodes</h2>
          <Onward newer={newerCard} older={olderCard} related={related} />
        </section>
      )
    }
  </div>
</Layout>

<script>
  import '../components/episode/split';
  import { focusInto } from '../components/episode/focus';

  // The clamped previews (notes, transcript) open from their button, from
  // keyboard focus landing on something they cut off, and from find in page
  // (a hidden="until-found" group's beforematch). Nothing they hide is in the
  // tab order meanwhile, and opening from the button moves focus to the
  // first control it reveals, or failing that the section's heading.
  const FOCUSABLE = 'a[href], button, input, select, textarea, [tabindex]';

  function open(box: HTMLElement, moveFocus: boolean) {
    const clamp = box.querySelector<HTMLElement>('[data-clamped]');
    if (!clamp) {
      return;
    }
    const fold = clamp.getBoundingClientRect().bottom;
    clamp.removeAttribute('data-clamped');
    // Only the preview's own groups: other things in it (the transcript's
    // jump markers) keep the hidden they were given.
    clamp
      .querySelectorAll<HTMLElement>('[hidden="until-found"]')
      .forEach((group) => group.removeAttribute('hidden'));
    box.querySelector<HTMLElement>('[data-ep-expand]')?.setAttribute('hidden', '');
    if (moveFocus) {
      const revealed = Array.from(
        clamp.querySelectorAll<HTMLElement>(FOCUSABLE)
      ).find((control) => control.getBoundingClientRect().top >= fold - 1);
      if (revealed) {
        revealed.focus();
      } else {
        focusInto(box.closest('section'));
      }
    }
  }

  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest?.('[data-ep-expand]');
    const box = button?.closest<HTMLElement>('.ep-clamp-box');
    if (box) {
      open(box, true);
    }
  });
  document.addEventListener('focusin', (event) => {
    const target = event.target as HTMLElement;
    const box = target.closest?.<HTMLElement>('.ep-clamp-box');
    const clamp = target.closest?.<HTMLElement>('[data-clamped]');
    // Only for focus on something the preview cuts off: tabbing through
    // what it shows leaves it a preview.
    if (
      box &&
      clamp &&
      target.matches(':focus-visible') &&
      target.getBoundingClientRect().bottom > clamp.getBoundingClientRect().bottom + 1
    ) {
      open(box, false);
    }
  });
  document.addEventListener(
    'beforematch',
    (event) => {
      const box = (event.target as Element).closest?.<HTMLElement>(
        '.ep-clamp-box'
      );
      if (box) {
        open(box, false);
      }
    },
    true
  );

  // Chrome resolves a scroll trigger's range once, when the trigger is
  // created, so a stage that settles afterwards (web fonts, the live script
  // filling in) would leave the bar's trigger off by that much. Re-arm it
  // whenever the stage changes size.
  let stageWatch: ResizeObserver | undefined;
  let splitWatch: MutationObserver | undefined;
  let groupWatch: ResizeObserver | undefined;
  let railWatch: MutationObserver | undefined;

  // While the sidebar's divider is held (`html[data-rail-held]`) the page
  // narrows every frame; both watches below wait for the release and then
  // run once. On release each is asked to look again (re-observed), so its
  // reads come after the next layout rather than forcing one in the
  // release's pointerup.
  const root = document.documentElement;
  const held = () => root.hasAttribute('data-rail-held');

  document.addEventListener('astro:page-load', () => {
    stageWatch?.disconnect();
    splitWatch?.disconnect();
    groupWatch?.disconnect();
    railWatch?.disconnect();
    // What to do on release, per watch: observe its targets afresh.
    const owed = new Map<ResizeObserver, () => void>();
    const whenFree = (
      observer: ResizeObserver,
      again: () => void,
      work: () => void
    ) => (held() ? owed.set(observer, again) : work());
    railWatch = new MutationObserver(() => {
      if (!held()) {
        owed.forEach((again) => again());
        owed.clear();
      }
    });
    railWatch.observe(root, { attributeFilter: ['data-rail-held'] });

    const stage = document.querySelector<HTMLElement>(
      '[data-stage][data-variant="page"]'
    );
    const meta = stage?.querySelector<HTMLElement>('.stage-meta');
    if (stage && meta) {
      const rearm = () => {
        meta.style.setProperty('timeline-trigger-name', 'none');
        void meta.offsetHeight;
        meta.style.removeProperty('timeline-trigger-name');
      };
      // The stage, or once split.ts lays it out split, the parts of its
      // picture side: there split.ts sets the stage's height from them in
      // its own observer, which an observer of the stage would only be told
      // of a frame late ("ResizeObserver loop completed with undelivered
      // notifications"). The parts are what moves the meta there.
      let targets: Array<Element> = [];
      const watch = () => {
        targets.forEach((target) => stageWatch!.unobserve(target));
        targets = stage.hasAttribute('data-split-on')
          ? Array.from(stage.querySelector('.stage-side')?.children ?? [])
          : [stage];
        targets.forEach((target) => stageWatch!.observe(target));
      };
      stageWatch = new ResizeObserver((_, observer) =>
        whenFree(observer, watch, rearm)
      );
      watch();
      splitWatch = new MutationObserver(watch);
      splitWatch.observe(stage, { attributeFilter: ['data-split-on'] });
    }

    // Groups of turns off screen hold the height of the first group (read
    // as it lays out, and again when the width or the fonts change it), so
    // what follows a long transcript sits close to where it will be.
    const group = document.querySelector<HTMLElement>('.ep-turns');
    if (group) {
      const measure = () =>
        group.parentElement?.style.setProperty(
          '--ep-group-h',
          String(Math.round(group.offsetHeight))
        );
      groupWatch = new ResizeObserver((_, observer) =>
        whenFree(
          observer,
          () => {
            observer.unobserve(group);
            observer.observe(group);
          },
          measure
        )
      );
      groupWatch.observe(group);
    }
  });
</script>
