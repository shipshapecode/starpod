---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Tiles from '../components/episode/Tiles.astro';
import { ArrowOutIcon, GithubIcon, LinkIcon, XIcon } from '../components/icons';
import { matchNames } from '../lib/cast';
import { optimizeImage } from '../lib/optimize-episode-image';
import { peopleBySlug } from '../lib/people';
import { getAllEpisodes, getShowInfo, type Episode } from '../lib/rss';
import starpodConfig from 'virtual:starpod/config';
import LargePlatforms from 'virtual:starpod/components/LargePlatforms';

import avatar from '../assets/avatar.svg?url';

const { hosts } = starpodConfig;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/img/people/*.{jpeg,jpg,png}'
);

// Fall back to the packaged avatar, which follows light and dark, when the
// site has not provided a photo in src/img/people yet.
const hostImage = async (img: string) =>
  (await images[`/src/img/people/${img}`]?.())?.default;

const linksFor = (host: (typeof hosts)[number]) =>
  [
    host.twitter && { href: host.twitter, label: 'Twitter', Icon: XIcon },
    host.github && { href: host.github, label: 'GitHub', Icon: GithubIcon },
    host.website && { href: host.website, label: 'Website', Icon: LinkIcon }
  ].filter(Boolean) as Array<{
    href: string;
    label: string;
    Icon: typeof LinkIcon;
  }>;

// What each host has done on the show, wherever episodes name them (the
// guests database or the feed: src/lib/people.ts): how many episodes, since
// when, how many hours, and the two latest.
const castBySlug = await peopleBySlug();
const everyone = [
  ...new Map(
    [...castBySlug.values()].flat().map((person) => [person.id, person])
  ).values()
];
const show = everyone.length ? await getShowInfo() : undefined;
const bySlug = new Map(
  (everyone.length ? await getAllEpisodes() : []).map((item) => [
    item.episodeSlug,
    item
  ])
);

const tile = async (item: Episode) => ({
  href: `/${item.episodeSlug}`,
  number: item.episodeNumber === 'Bonus' ? 'Bonus' : `Ep ${item.episodeNumber}`,
  title: item.title,
  art:
    (await optimizeImage(item.episodeImage ?? show!.image, {
      width: 320,
      height: 320
    })) ?? show!.image
});

// Each configured host's record: the same name, or surely the same person,
// one each, whatever order the episodes name them in.
const recordOf = matchNames(
  hosts.map((host) => host.name),
  everyone.map((candidate) => candidate.name)
);

const posters = await Promise.all(
  hosts.map(async (host, index) => {
    const person = everyone.find(
      (candidate) => candidate.name === recordOf.get(host.name)
    );
    const theirs = person
      ? [...castBySlug]
          .filter(([, cast]) => cast.some((one) => one.id === person.id))
          .map(([slug]) => bySlug.get(slug))
          .filter((item): item is Episode => Boolean(item))
          .sort((a, b) => b.published - a.published)
      : [];
    const hours = Math.round(
      theirs.reduce((sum, item) => sum + (item.duration || 0), 0) / 3600
    );
    return {
      ...host,
      id: person?.id,
      photo: await hostImage(host.img),
      voice: index < 2 ? index : undefined,
      count: theirs.length,
      stats: theirs.length
        ? [
            `${theirs.length} ${theirs.length === 1 ? 'episode' : 'episodes'}`,
            `since ${new Date(theirs.at(-1)!.published).getFullYear()}`,
            `${hours} ${hours === 1 ? 'hour' : 'hours'}`
          ].join(' · ')
        : undefined,
      theirs,
      recent: await Promise.all(theirs.slice(0, 2).map(tile))
    };
  })
);

// When every host's latest two are the same episodes, each poster would
// repeat one row: show it once beneath them instead, as the latest episodes
// they made together, and keep each poster's way to all of theirs.
const recentOf = (poster: (typeof posters)[number]) =>
  poster.recent.map((item) => item.href).join(' ');
const together =
  posters.length > 1 &&
  posters[0].recent.length > 0 &&
  posters.every((poster) => recentOf(poster) === recentOf(posters[0]))
    ? await Promise.all(
        posters[0].theirs
          .filter((item) =>
            posters.every((poster) => poster.theirs.includes(item))
          )
          .slice(0, 4)
          .map(tile)
      )
    : [];

// The photo's lower third fades into the poster's ground (.ab-host-photo's
// ::after); a hairline sits just inside it, above the picture.
const hostPhoto =
  'block size-full rounded-t-card object-cover object-[center_30%] outline-1 -outline-offset-1 outline-hairline';

// The name in the host's voice: voice 0 condensed Archivo, voice 1 Young
// Serif, anyone else the plain grotesque.
const voiceName: Record<number, string> = {
  0: 'font-voice-0 font-heavy font-stretch-[72%] uppercase',
  1: 'font-voice-1 font-normal'
};
---

<Layout title="About">
  <div class="relative z-10">
    <PageHeader title="About the show">
      <p class="m-0">{starpodConfig.description}</p>
    </PageHeader>

    <section aria-labelledby="listen-heading" class="ep-reveal">
      <h2 class="section-title" id="listen-heading">Listen on</h2>
      <LargePlatforms />
    </section>

    <section aria-labelledby="hosts-heading" class="mt-16 lg:mt-20">
      <h2 class="section-title" id="hosts-heading">Meet the hosts</h2>

      {/* Each poster is a subgrid of six rows (photo, name, stats, bio,
          episodes, links), so side by side the bios, episodes and links
          line up even when one host's bio runs longer. The list's row gap is
          the posters' own 12px (a subgrid's rows share it), and each poster's
          margin makes up the 24px between stacked posters. */}
      <ul class="grid grid-cols-1 gap-x-6 gap-y-3 lg:grid-cols-2">
        {
          posters.map((host) => (
            <li
              class="ab-host ep-reveal row-span-6 mb-3 grid grid-cols-1 grid-rows-subgrid overflow-clip rounded-card bg-(--ab-ground) pb-6"
              data-voice={host.voice}
            >
              <div
                class="ab-host-photo relative row-start-1 aspect-[4/3] max-h-75 w-full"
                data-props-for="img-color"
                data-props-to=".ab-host"
              >
                {host.photo ? (
                  <Image alt="" class={hostPhoto} src={host.photo} width={720} />
                ) : (
                  <img
                    alt=""
                    class={hostPhoto}
                    height={540}
                    src={avatar}
                    width={720}
                  />
                )}
              </div>

              {/* Over the photo's faded foot, and sized to the poster (the
                  wrapper is the container: on the poster itself, containment
                  would stop it being a subgrid), so the longest one-word name
                  still fits on one line. */}
              <div class="@container relative row-start-2 mx-6 -mt-10">
                <h3
                  class={`m-0 text-[min(2.5rem,100cqi/8.5)] leading-none text-[var(--person-ring,var(--ink))] ${voiceName[host.voice ?? -1] ?? 'font-extrabold'}`}
                >
                  {host.name}
                </h3>
              </div>
              {host.stats && <p class="person-fact row-start-3 mx-6">{host.stats}</p>}
              {host.bio && <p class="row-start-4 mx-6 max-w-bio text-text">{host.bio}</p>}

              {together.length === 0 && host.recent.length > 0 && (
                <div class="ab-host-tray row-start-5 mx-6 box-border grid justify-items-start gap-3 self-start rounded-tray bg-surface/72 px-1 pt-1 pb-3">
                  <Tiles
                    items={host.recent}
                    label={`Latest episodes with ${host.name}`}
                  />
                  {host.id && (
                    <a
                      aria-label={`All ${host.count} episodes with ${host.name}`}
                      class="ep-pill"
                      href={`/#guest=${encodeURIComponent(host.id)}`}
                    >
                      All {host.count}
                      <ArrowOutIcon size={14} />
                    </a>
                  )}
                </div>
              )}
              {together.length > 0 && host.id && (
                <div class="row-start-5 mx-6">
                  <a
                    aria-label={`All ${host.count} episodes with ${host.name}`}
                    class="ep-pill"
                    href={`/#guest=${encodeURIComponent(host.id)}`}
                  >
                    All {host.count}
                    <ArrowOutIcon size={14} />
                  </a>
                </div>
              )}

              {linksFor(host).length > 0 && (
                <ul class="ab-host-links row-start-6 mx-6 mt-1 flex flex-wrap gap-2 self-start">
                  {linksFor(host).map(({ href, Icon, label }) => (
                    <li>
                      <a
                        class="ep-pill"
                        href={href}
                        rel="noopener"
                        target="_blank"
                      >
                        <Icon size={16} />
                        {label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      {
        together.length > 0 && (
          <div class="ep-reveal mt-8">
            <h3 class="mb-3 text-base leading-5 font-demibold">Latest episodes</h3>
            <Tiles items={together} label="Latest episodes with the hosts" />
          </div>
        )
      }
    </section>
  </div>
</Layout>
