---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { ArrowOutIcon } from '../components/icons';
import starpodConfig from 'virtual:starpod/config';
import LargePlatforms from 'virtual:starpod/components/LargePlatforms';

import avatarLight from '../assets/avatar-light.png';

const { hosts } = starpodConfig;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/img/people/*.{jpeg,jpg,png}'
);

// Fall back to the packaged avatar when the site has not provided a photo in
// src/img/people yet.
const hostImage = (img: string) =>
  images[`/src/img/people/${img}`]?.() ?? avatarLight;

const linksFor = (host: (typeof hosts)[number]) =>
  [
    host.twitter && { href: host.twitter, label: 'Twitter' },
    host.github && { href: host.github, label: 'GitHub' },
    host.website && { href: host.website, label: 'Website' }
  ].filter(Boolean) as Array<{ href: string; label: string }>;
---

<Layout title="About">
  <div class="relative z-10">
    <PageHeader title="About the show">
      <p class="m-0">{starpodConfig.description}</p>
    </PageHeader>

    <section aria-labelledby="listen-heading">
      <h2 class="section-title" id="listen-heading">Listen on</h2>
      <LargePlatforms />
    </section>

    <section aria-labelledby="hosts-heading" class="mt-16 lg:mt-20">
      <h2 class="section-title" id="hosts-heading">Meet the hosts</h2>

      <ul class="m-0 grid list-none gap-x-12 gap-y-12 p-0 lg:grid-cols-2">
        {
          hosts.map((host) => (
            <li class="flex gap-5 sm:gap-6">
              <Image
                alt=""
                class="size-20 shrink-0 rounded-2xl object-cover sm:size-28"
                height={224}
                src={hostImage(host.img)}
                width={224}
              />

              <div class="min-w-0">
                <h3 class="text-ink m-0 text-xl leading-tight font-bold sm:text-2xl">
                  {host.name}
                </h3>

                {host.bio && <p class="text-text mt-2 mb-0 max-w-[48ch]">{host.bio}</p>}

                {linksFor(host).length > 0 && (
                  <ul class="m-0 mt-4 flex list-none flex-wrap gap-x-5 gap-y-2 p-0">
                    {linksFor(host).map((link) => (
                      <li>
                        <a
                          class="text-ink group inline-flex items-center gap-1.5 text-sm font-semibold no-underline"
                          href={link.href}
                          rel="noopener"
                          target="_blank"
                        >
                          <span class="underline decoration-transparent underline-offset-4 transition-[text-decoration-color] duration-300 group-hover:decoration-current">
                            {link.label}
                          </span>
                          <span class="text-muted transition-colors duration-300 group-hover:text-ink">
                            <ArrowOutIcon size={14} />
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
