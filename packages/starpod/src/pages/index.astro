---
import Layout from '../layouts/Layout.astro';
import EpisodeList from 'virtual:starpod/components/EpisodeList';
import { getAllEpisodes, getShowInfo } from '../lib/rss';

const episodes = await getAllEpisodes();
const show = await getShowInfo();
---

<Layout title={show.title}>
  <div class="relative z-10">
    <h1 class="text-ink mb-6 text-4xl font-bold">
      Episodes <span class="text-muted text-base font-semibold">{episodes.length}</span>
    </h1>

    <EpisodeList episodes={episodes} show={show} />
  </div>
</Layout>
