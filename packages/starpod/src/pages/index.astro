---
import Layout from '../layouts/Layout.astro';
import EpisodeList from 'virtual:starpod/components/EpisodeList';
import { loadArchive } from '../components/explorer/archive';
import Hero from '../components/explorer/Hero.astro';
import { getAllEpisodes, getShowInfo } from '../lib/rss';

const episodes = await getAllEpisodes();
const show = await getShowInfo();
const { cards, people, years } = await loadArchive(episodes, show);
---

<Layout title={show.title}>
  <h1 class="sr-only">{show.title}</h1>
  {cards[0] && <Hero card={cards[0]} show={show} />}
  <EpisodeList
    cards={cards}
    episodes={episodes}
    people={people}
    show={show}
    years={years}
  />
</Layout>
